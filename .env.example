SERVER_PORT=8081

# Local Docker Compose defaults
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/shareway_trip_planning
SPRING_DATASOURCE_USERNAME=shareway
SPRING_DATASOURCE_PASSWORD=shareway

# Render + Filess.io example
# PORT is provided automatically by Render.
# Replace these values in Render Dashboard with the PostgreSQL credentials from Filess.io.
# SPRING_DATASOURCE_URL=jdbc:postgresql://<filess-host>:<filess-port>/<filess-database>
# SPRING_DATASOURCE_USERNAME=<filess-user>
# SPRING_DATASOURCE_PASSWORD=<filess-password>
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=1
SPRING_FLYWAY_SCHEMAS=shareway
SPRING_FLYWAY_DEFAULT_SCHEMA=shareway
