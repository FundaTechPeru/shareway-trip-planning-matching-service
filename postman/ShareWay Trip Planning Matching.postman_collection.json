{
  "info": {
    "name": "ShareWay Trip Planning & Matching",
    "description": "TP1 collection for validating the Trip Planning & Matching microservice. Every /api/v1 request sends a bearer token issued by Driver Management (POST /api/v1/auth/login through the API Gateway): set passengerToken to a PASSENGER token and driverToken to a DRIVER token. With the dev profile they must be signed with the shared development JWT_SECRET.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/actuator/health"
      }
    },
    {
      "name": "Register driver availability",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operationZone\": \"Chorrillos\",\n  \"availableDate\": \"2026-10-04\",\n  \"startTime\": \"07:00:00\",\n  \"endTime\": \"09:00:00\",\n  \"availableSeats\": 3\n}"
        },
        "url": "{{baseUrl}}/api/v1/driver-availabilities",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{driverToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('driverAvailabilityId', pm.response.json().id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "List my driver availabilities",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{driverToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/driver-availabilities"
      }
    },
    {
      "name": "Create trip request",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('tripRequestId', pm.response.json().id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"originLabel\": \"UPC Monterrico\",\n  \"destinationLabel\": \"Chorrillos\",\n  \"operationZone\": \"Chorrillos\",\n  \"originLat\": -12.104800,\n  \"originLng\": -76.963200,\n  \"destinationLat\": -12.172100,\n  \"destinationLng\": -77.016400,\n  \"travelDate\": \"2026-10-04\",\n  \"earliestDeparture\": \"07:30:00\",\n  \"latestDeparture\": \"08:30:00\",\n  \"seatsRequested\": 1\n}"
        },
        "url": "{{baseUrl}}/api/v1/trip-requests",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{passengerToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "List my trip requests",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/trip-requests",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{passengerToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Generate match proposals",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/trip-requests/{{tripRequestId}}/match-proposals",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{passengerToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "List match proposals",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/trip-requests/{{tripRequestId}}/match-proposals",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{passengerToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Accept trip group (US-21)",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{driverToken}}",
              "type": "string"
            }
          ]
        },
        "description": "OPEN -> ACCEPTED. Queues GroupCompleted and ProposalAccepted. A second call answers 409.",
        "url": "{{baseUrl}}/api/v1/driver-availabilities/{{driverAvailabilityId}}/accept"
      }
    },
    {
      "name": "Reject trip group (US-21)",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{driverToken}}",
              "type": "string"
            }
          ]
        },
        "description": "OPEN -> REJECTED. Queues GroupRejected. Answers 409 when the group was already accepted or rejected: register a new availability first.",
        "url": "{{baseUrl}}/api/v1/driver-availabilities/{{driverAvailabilityId}}/reject"
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "passengerToken",
      "value": ""
    },
    {
      "key": "driverToken",
      "value": ""
    },
    {
      "key": "tripRequestId",
      "value": ""
    },
    {
      "key": "driverAvailabilityId",
      "value": ""
    }
  ]
}
